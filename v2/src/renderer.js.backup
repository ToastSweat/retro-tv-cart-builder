const root=document.querySelector('#app'),message=document.querySelector('#message');let current=null,rows=[],parent='',mode='welcome';
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function call(key,...args){message.style.display='none';const r=await window.retro[key](...args);if(r.error)throw Error(r.error);return r.value;}
function error(e){message.textContent=e.message;message.style.display='block';}
function action(id,fn){document.getElementById(id).onclick=async e=>{const b=e.currentTarget;b.disabled=true;try{await fn();}catch(e){error(e);}finally{b.disabled=false;}};}
async function welcome(){mode='welcome';current=null;const recent=await call('recent');root.innerHTML=`<div class="eyebrow">A new broadcast starts here</div><h1>Your television, assembled.</h1><p>Create a collection of carts or return to an existing project.</p><div class="actions"><button class="primary" id="new">New Project</button><button id="open">Open Project…</button></div><section class="panel"><h2>Recent projects</h2>${recent.length?recent.map((r,i)=>`<button class="recent" id="recent${i}">${esc(r.name)}<span>${esc(r.file)}</span></button>`).join(''):'<p>No projects yet. Create your first collection above.</p>'}</section><p class="note">Projects own their data and generated files. Media libraries remain source-only.</p>`;action('new',()=>edit(false));action('open',async()=>{const p=await call('open');if(p){current=p;overview();}});recent.forEach((r,i)=>action('recent'+i,async()=>{current=await call('open',r.file);overview();}));}
const descriptions={data:'Project records and settings backups',artwork:'Network, show and cart artwork',composites:'Combined episode blocks',cache:'Previews and temporary renders',builds:'Rendered cart builds',exports:'Prepared USB and Jellyfin outputs'};
function folders(){return `<div class="foldergrid">${Object.entries(descriptions).map(([k,v])=>`<div><strong>${k}/</strong><span>${v}</span></div>`).join('')}</div>`;}
function libraryList(){document.querySelector('#libs').innerHTML=rows.map((r,i)=>`<div class="panel"><label for="lib${i}">Library name</label><div class="row"><input id="lib${i}" value="${esc(r.name)}"><button id="loc${i}">Locate…</button><button id="remove${i}">Remove</button></div><div class="path">${esc(r.path)}</div></div>`).join('')||'<p class="note">No libraries added. You can add them later.</p>';rows.forEach((r,i)=>{document.querySelector('#lib'+i).oninput=e=>r.name=e.target.value;action('loc'+i,async()=>{const p=await call('folder');if(p){r.path=p;libraryList();}});action('remove'+i,()=>{rows.splice(i,1);libraryList();});});}
function edit(existing){mode=existing?'settings':'create';rows=existing?current.project.libraries.map(x=>({...x})):[];parent='';root.innerHTML=`<div class="eyebrow">${existing?'Project settings':'First step'}</div><h1>${existing?'Make yourself at home.':'Create your project.'}</h1><label for="name">Project name</label><input id="name" maxlength="100" value="${esc(existing?current.project.name:'')}" placeholder="My Mini Retro Television">${existing?`<p class="path">${esc(current.root)}</p><p class="note">Renaming changes the display name, not the folder name.</p>`:'<label>Project location</label><button id="parent">Choose parent folder…</button><p id="destination" class="path">A new folder named after your project will be created here.</p>'}<section class="panel"><h2>Project storage</h2>${folders()}<p class="note">These folders stay inside your project. Move the whole project folder to relocate it.</p></section><h2>Source libraries</h2><p class="note">Reference existing media folders. Nothing is copied, moved or written into them.</p><div id="libs"></div><button id="add">Add library folder…</button><div class="actions"><button class="primary" id="save">${existing?'Save settings':'Create project'}</button><button id="cancel">Cancel</button></div>`;libraryList();if(!existing){const preview=()=>document.querySelector('#destination').textContent=parent?parent+' / '+document.querySelector('#name').value:'Choose a parent folder.';action('parent',async()=>{const p=await call('folder');if(p){parent=p;preview();}});document.querySelector('#name').oninput=preview;}
 action('add',async()=>{const p=await call('folder');if(p){rows.push({name:p.split(/[\\/]/).filter(Boolean).pop(),path:p});libraryList();}});
 action('cancel',()=>existing?overview():welcome());action('save',async()=>{const input={name:document.querySelector('#name').value,libraries:rows,parent};if(!existing&&!parent)throw Error('Choose a project parent folder.');current=await call(existing?'update':'create',input);overview();});}
function overview(){mode='project';root.innerHTML=`<div class="eyebrow">Project open</div><h1>${esc(current.project.name)}</h1><p class="path">${esc(current.root)}</p><div class="actions"><button class="primary" id="organization">Networks &amp; Shows</button><button id="settings">Project settings</button><button id="close">Close project</button></div><section class="panel"><h2>Source libraries</h2>${current.libraries.map(r=>`<p><strong>${esc(r.name)}</strong> · <span class="${r.available?'':'warning'}">${r.available?'Available':'Missing — locate in project settings'}</span><br><span class="path">${esc(r.path)}</span></p>`).join('')||'<p>No libraries configured yet.</p>'}</section><section class="panel"><h2>Project storage</h2>${folders()}</section><p class="note">Usage tracking is project-local. Cross-project locking is off. Usage tracking will be implemented with cart generation.</p><section class="panel"><h2>Build your station lineup</h2><p>Create networks, add shows, and associate each show with one or more networks. Carts and templates come next.</p></section>`;action('organization',()=>organization());action('settings',()=>edit(true));action('close',async()=>{await call('close');await welcome();});}
welcome().catch(error);

let organizationData=null,organizationKind='networks';
async function organization(kind=organizationKind){
 mode='organization';organizationKind=kind;organizationData=await call('catalog');
 root.innerHTML=`<div class="eyebrow">Project organization</div><h1>Networks &amp; Shows</h1><p>Give your collection its stations and shows. These records belong to ${esc(current.project.name)}.</p><div class="actions"><button id="backProject">Back to project</button><button id="networksTab" class="${kind==='networks'?'primary':''}">Networks (${organizationData.networks.length})</button><button id="showsTab" class="${kind==='shows'?'primary':''}">Shows (${organizationData.shows.length})</button></div><div class="sectionhead"><h2>${kind==='networks'?'Your networks':'Your shows'}</h2><button class="primary" id="addEntry">${kind==='networks'?'Add network':'Add show'}</button></div><label class="sr-only" for="searchEntries">Search ${kind}</label><input id="searchEntries" type="search" placeholder="Search ${kind}…"><div id="entryList" class="cards"></div><div id="entryEditor"></div>`;
 action('backProject',()=>overview());action('networksTab',()=>organization('networks'));action('showsTab',()=>organization('shows'));action('addEntry',()=>entryEditor(kind));document.querySelector('#searchEntries').oninput=renderEntries;renderEntries();
}
function renderEntries(){
 const kind=organizationKind,search=document.querySelector('#searchEntries').value.trim().toLowerCase();
 const list=organizationData[kind].filter(r=>(r.name+' '+(r.shortName||'')).toLowerCase().includes(search)).sort((a,b)=>a.name.localeCompare(b.name));
 document.querySelector('#entryList').innerHTML=list.length?list.map((row,i)=>{
 const preview=organizationData.previews[row.id];
 const detail=kind==='networks'?`${organizationData.shows.filter(s=>s.networkIds.includes(row.id)).length} associated show(s)`:row.networkIds.map(id=>organizationData.networks.find(n=>n.id===id)?.shortName).join(' · ')||'No networks assigned';
 return `<article class="entrycard"><div class="poster">${preview?`<img src="${esc(preview)}" alt="${esc(row.name)} artwork">`:`<span>${esc(kind==='networks'?row.shortName:row.name.slice(0,2).toUpperCase())}</span>`}</div><div class="entrybody">${kind==='networks'?`<span class="eyebrow">${esc(row.shortName)}</span>`:''}<h3>${esc(row.name)}</h3><p>${esc(detail)}</p>${row.artwork&&!preview?'<p class="warning">Artwork missing. Edit to choose another image.</p>':''}<button id="entry${i}">Edit ${kind==='networks'?'network':'show'}</button></div></article>`;
 }).join(''):`<section class="panel empty"><h2>${search?'No matches':'Nothing here yet'}</h2><p>${search?'Try another name.':kind==='networks'?'Start with a network, such as Nickelodeon / NICK.':'Add a show, such as Rugrats, then choose its networks.'}</p></section>`;
 list.forEach((row,i)=>action('entry'+i,()=>entryEditor(kind,row)));
}
function entryEditor(kind,record=null){
 const host=document.querySelector('#entryEditor');let artworkToken=null,removeArtwork=false;
 const previousPreview=record?organizationData.previews[record.id]:null;
 host.innerHTML=`<div class="editorbackdrop"><section class="editor" role="dialog" aria-modal="true" aria-labelledby="editorTitle"><div class="eyebrow">${record?'Edit':'Create'} ${kind==='networks'?'network':'show'}</div><h2 id="editorTitle">${record?esc(record.name):kind==='networks'?'A place on the dial':'A show in your collection'}</h2><label for="entryName">${kind==='networks'?'Long name':'Show name'}</label><input id="entryName" maxlength="100" value="${esc(record?.name||'')}" placeholder="${kind==='networks'?'Nickelodeon':'Rugrats'}">${kind==='networks'?`<label for="shortName">Short name</label><input id="shortName" maxlength="16" value="${esc(record?.shortName||'')}" placeholder="NICK">`:`<fieldset><legend>Networks</legend><p class="note">A show can belong to multiple networks, or none yet.</p>${organizationData.networks.map((n,i)=>`<label class="check"><input type="checkbox" name="network" value="${esc(n.id)}" ${record?.networkIds.includes(n.id)?'checked':''}>${esc(n.name)} <span>(${esc(n.shortName)})</span></label>`).join('')||'<p class="note">Create a network to assign this show later.</p>'}</fieldset>`}<label>Artwork</label><div class="artpreview" id="artPreview">${previousPreview?`<img src="${esc(previousPreview)}" alt="Artwork preview">`:'<span>No artwork selected</span>'}</div><div class="actions"><button id="chooseArt">Choose image…</button><button id="clearArt">Remove artwork</button></div><p class="note">PNG, JPEG or WebP, up to 15 MB. Saving copies the image into this project; the original stays untouched.</p><div id="editorError" class="warning" role="alert"></div><div class="actions"><button class="primary" id="saveEntry">Save ${kind==='networks'?'network':'show'}</button><button id="cancelEntry">Cancel</button>${record?'<button class="danger" id="deleteEntry">Remove entry…</button>':''}</div></section></div>`;
 const close=()=>{host.innerHTML='';document.querySelector('#addEntry').focus();};
 // Keep tab focus inside the editor. Escape follows the same discard check as Cancel.
 const dialog=host.querySelector('[role="dialog"]');
 const original=()=>JSON.stringify({name:document.querySelector('#entryName').value,short:kind==='networks'?document.querySelector('#shortName').value:null,networks:[...host.querySelectorAll('input[name="network"]:checked')].map(x=>x.value)});
 const initial=original();const cancel=async()=>{if(artworkToken||removeArtwork||original()!==initial){if(!await call('discard'))return;}close();};
 dialog.onkeydown=e=>{if(e.key==='Escape'){e.preventDefault();cancel().catch(error);}if(e.key==='Tab'){const controls=[...dialog.querySelectorAll('input,button')].filter(x=>!x.disabled);const first=controls[0],last=controls.at(-1);if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}}};
 action('chooseArt',async()=>{const chosen=await call('pickArtwork');if(chosen){artworkToken=chosen.token;removeArtwork=false;document.querySelector('#artPreview').innerHTML=`<img src="${esc(chosen.preview)}" alt="Selected artwork preview">`;}});
 action('clearArt',()=>{artworkToken=null;removeArtwork=true;document.querySelector('#artPreview').innerHTML='<span>No artwork selected</span>';});
 action('cancelEntry',cancel);
 action('saveEntry',async()=>{
  try{organizationData=await call('saveEntry',kind,{id:record?.id,name:document.querySelector('#entryName').value,shortName:kind==='networks'?document.querySelector('#shortName').value:undefined,networkIds:kind==='shows'?[...host.querySelectorAll('input[name="network"]:checked')].map(x=>x.value):undefined,artworkToken,removeArtwork});close();renderEntries();document.querySelector('#'+(kind==='networks'?'networksTab':'showsTab')).textContent=`${kind==='networks'?'Networks':'Shows'} (${organizationData[kind].length})`;}
  catch(e){document.querySelector('#editorError').textContent=e.message;}
 });
 if(record)action('deleteEntry',async()=>{const next=await call('removeEntry',kind,record.id);if(next){organizationData=next;close();await organization(kind);}});
 document.querySelector('#entryName').focus();
}
